{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/hotel.schema.json",
  "title": "Hotel Website Data",
  "description": "Reusable data contract for building a small-hotel static website with a booking-request + WhatsApp pipeline. One JSON instance per hotel. The build prompt reads only this file, so adding a hotel never means editing the prompt.",
  "type": "object",
  "required": ["schema_version", "hotel", "rooms", "activities", "policies", "pricing", "booking", "contact"],
  "additionalProperties": false,
  "properties": {

    "schema_version": {
      "type": "string",
      "description": "Semver of this schema. Bump when the shape changes so old instances can be migrated.",
      "const": "1.0.0"
    },

    "_assumptions": {
      "type": "array",
      "description": "Every value filled by the builder's discretion rather than the owner, so it can be reviewed or overridden. Keep this honest — it is the audit trail.",
      "items": {
        "type": "object",
        "required": ["field", "value", "basis"],
        "properties": {
          "field": { "type": "string", "description": "Dotted path, e.g. policies.check_in_time" },
          "value": { "description": "What was assumed" },
          "basis": { "type": "string", "description": "Why this default is reasonable" }
        }
      }
    },

    "_todos": {
      "type": "array",
      "description": "Facts genuinely unknown and NOT safe to default. The build must render these as visible [TODO] markers, never as invented content.",
      "items": { "type": "string" }
    },

    "hotel": {
      "type": "object",
      "required": ["name", "type", "pitch"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "legal_name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["Hotel", "Guesthouse", "Homestay", "Resort", "Lodge", "Hostel", "Boutique hotel", "Other"]
        },
        "tagline": { "type": "string" },
        "year_opened": { "type": "string" },
        "pitch": {
          "type": "object",
          "description": "Who stays and why they choose this place. Source material for copy, not final copy.",
          "required": ["raw"],
          "properties": {
            "raw": { "type": "string", "description": "Owner's own words, verbatim, original language" },
            "target_guests": { "type": "array", "items": { "type": "string" } },
            "differentiators": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },

    "location": {
      "type": "object",
      "description": "Mostly researched by the builder, not asked of the owner.",
      "additionalProperties": false,
      "properties": {
        "address": { "type": "string" },
        "locality": { "type": "string" },
        "region": { "type": "string" },
        "country": { "type": "string" },
        "maps_url": { "type": "string" },
        "geo": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "landmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "travel_time": { "type": "string" },
              "mode": { "type": "string" }
            }
          }
        },
        "nearby_attractions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "travel_time": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        },
        "seasonality": { "type": "string", "description": "Best/worst months, monsoon access, festival crowds." }
      }
    },

    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "price", "currency"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "count": { "type": ["integer", "null"] },
          "price": { "type": "number", "description": "Base nightly rate for the default occupancy below. Pre-tax if pricing.tax_included is false." },
          "price_single": { "type": ["number", "null"], "description": "Rate for one guest, if different" },
          "currency": { "type": "string", "enum": ["NPR", "INR", "USD", "EUR"] },
          "occupancy": { "type": "string", "description": "e.g. '2 adults'" },
          "breakfast_included": { "type": "boolean" },
          "cooling": { "type": "string", "enum": ["AC", "Fan", "None"] },
          "hot_water": { "type": "string", "enum": ["24 hours", "Limited hours", "Solar", "On request", "Not available"] },
          "amenities": { "type": "array", "items": { "type": "string" } },
          "differentiator": { "type": "string" },
          "raw": { "type": "string", "description": "Original unparsed line, kept so nothing is silently lost." }
        }
      }
    },

    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "duration": { "type": "string" },
          "price_per_person": { "type": ["number", "null"] },
          "currency": { "type": "string", "enum": ["NPR", "INR", "USD", "EUR"] },
          "operated_by": { "type": "string", "enum": ["in_house", "partner", "mixed", "unknown"], "description": "Controls whether copy may say 'we operate' vs 'we arrange'." },
          "extras_note": { "type": "string", "description": "Whether permits, guide, or entry fees are additional. Critical for park safaris." },
          "raw": { "type": "string" }
        }
      }
    },

    "packages": {
      "type": "array",
      "description": "Bundled deals. For a safari hotel the package is often the real product.",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "includes": { "type": "array", "items": { "type": "string" } },
          "nights": { "type": ["integer", "null"] },
          "price": { "type": ["number", "null"] },
          "currency": { "type": "string", "enum": ["NPR", "INR", "USD", "EUR"] }
        }
      }
    },

    "policies": {
      "type": "object",
      "required": ["cancellation"],
      "additionalProperties": false,
      "properties": {
        "check_in_time": { "type": "string" },
        "check_out_time": { "type": "string" },
        "cancellation": {
          "type": "object",
          "required": ["raw"],
          "properties": {
            "raw": { "type": "string", "description": "Owner's exact wording. Translate carefully; a wrong refund rule is a real dispute." }
          }
        },
        "advance_payment": { "type": "string" },
        "children": { "type": "string" },
        "pets": { "type": "string", "enum": ["Allowed", "Not allowed", "Case by case"] },
        "smoking": { "type": "string" }
      }
    },

    "pricing": {
      "type": "object",
      "required": ["display_currency", "tax_included", "display_mode"],
      "additionalProperties": false,
      "properties": {
        "display_currency": { "type": "string", "enum": ["NPR", "INR", "USD", "EUR"] },
        "tax_included": { "type": "boolean", "description": "If false, every displayed price must carry a '+ taxes' note." },
        "tax_note": { "type": "string", "description": "e.g. '+ 13% VAT and 10% service charge'. Leave generic if percentages unconfirmed." },
        "foreign_guest_pricing": { "type": "string", "enum": ["same", "different_rate", "usd_quoted"] },
        "seasonal": { "type": "string", "description": "Free text on seasonal changes, or 'none'." },
        "display_mode": { "type": "string", "enum": ["exact", "from", "on_request"] },
        "direct_booking_perk": { "type": "string" }
      }
    },

    "booking": {
      "type": "object",
      "required": ["level", "notification_channels", "who_handles"],
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["enquiry_only", "booking_request", "live_availability", "book_and_pay", "third_party_engine"],
          "description": "Architecture selector. This pack implements booking_request. Higher levels are out of scope by design."
        },
        "pay_online": { "type": "boolean" },
        "live_availability": { "type": "boolean" },
        "who_handles": { "type": "string" },
        "response_time_promise": { "type": "string", "description": "Shown on the confirmation screen and in the auto-reply." },
        "notification_channels": {
          "type": "array",
          "items": { "type": "string", "enum": ["Email", "WhatsApp", "SMS"] }
        },
        "reference_prefix": { "type": "string", "description": "Booking ref prefix, e.g. 'HTL'." }
      }
    },

    "contact": {
      "type": "object",
      "required": ["phones", "email"],
      "additionalProperties": false,
      "properties": {
        "phones": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "description": "International format, e.g. +9779855014822" }
        },
        "whatsapp": { "type": "string", "description": "Digits only, international, no plus or spaces — this is what wa.me needs." },
        "email": { "type": "string", "format": "email" },
        "reception_hours": { "type": "string" },
        "social": {
          "type": "object",
          "properties": {
            "facebook": { "type": "string" },
            "instagram": { "type": "string" },
            "tripadvisor": { "type": "string" },
            "youtube": { "type": "string" }
          }
        }
      }
    },

    "reviews": {
      "type": "object",
      "description": "Researched by the builder from Google/TripAdvisor, not asked.",
      "properties": {
        "rating": { "type": ["number", "null"] },
        "count": { "type": ["integer", "null"] },
        "source": { "type": "string" },
        "quotes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "name": { "type": "string" },
              "country": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        }
      }
    },

    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logo_status": { "type": "string", "enum": ["vector_file", "image_file", "signboard_only", "none"] },
        "colors": {
          "type": "object",
          "description": "Hex values. Builder may derive from logo/signboard if not supplied.",
          "properties": {
            "primary": { "type": "string" },
            "accent": { "type": "string" },
            "ink": { "type": "string" },
            "paper": { "type": "string" }
          }
        },
        "feel": { "type": "string" },
        "imagery_avoid": { "type": "string" }
      }
    },

    "site": {
      "type": "object",
      "description": "Web/admin facts.",
      "additionalProperties": false,
      "properties": {
        "languages": { "type": "array", "items": { "type": "string", "enum": ["English", "Nepali", "Hindi", "Chinese", "Other"] } },
        "primary_language": { "type": "string" },
        "domain_owned": { "type": "boolean" },
        "domain_candidates": { "type": "array", "items": { "type": "string" } },
        "approver": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "phone": { "type": "string" }
          }
        },
        "seo_phrases": { "type": "array", "items": { "type": "string" } }
      }
    },

    "media": {
      "type": "object",
      "description": "Filled after the shot list is delivered. Build references /images/<file> and emits a manifest.",
      "properties": {
        "photos_available": { "type": "string" },
        "manifest_path": { "type": "string" }
      }
    }
  }
}
